{
  "id": "kubohiroyaruntimeexpression",
  "name": "Runtime Expression",
  "docsURI": "https://kubohiroya.github.io/turbowarp-runtime-expression/",
  "blockIconURI": "data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2048%2048%22%3E%3Cpath%20d%3D%22M6%2036h13V14h23%22%20fill%3D%22none%22%20stroke%3D%22%23E6533C%22%20stroke-width%3D%224.4%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%2F%3E%3Ccircle%20cx%3D%2219%22%20cy%3D%2225%22%20r%3D%225%22%20fill%3D%22%23FFAB19%22%2F%3E%3C%2Fsvg%3E",
  "color1": "#6f5bd3",
  "color2": "#5845b8",
  "color3": "#40328e",
  "blocks": [
    {
      "opcode": "validateConditionSyntax",
      "blockType": "reporter",
      "text": "validate condition syntax [EXPRESSION]",
      "hideFromPalette": true,
      "arguments": {
        "EXPRESSION": {
          "type": "string",
          "defaultValue": "state == \"ready\""
        }
      }
    },
    {
      "opcode": "runtimeCondition",
      "blockType": "Boolean",
      "text": "condition [EXPRESSION]",
      "arguments": {
        "EXPRESSION": {
          "type": "string",
          "defaultValue": "state == \"ready\""
        }
      }
    },
    {
      "opcode": "registerConditionalBroadcast",
      "blockType": "command",
      "text": "register [ID] conditional broadcast [CONDITION] [MESSAGE_ON_TRUE] / [MESSAGE_ON_FALSE] with [TIMEOUT] seconds timeout",
      "arguments": {
        "ID": {
          "type": "string",
          "defaultValue": "watcher"
        },
        "CONDITION": {
          "type": "string",
          "defaultValue": "state == \"ready\""
        },
        "MESSAGE_ON_TRUE": {
          "type": "string",
          "defaultValue": "state ready"
        },
        "MESSAGE_ON_FALSE": {
          "type": "string",
          "defaultValue": "state not ready"
        },
        "TIMEOUT": {
          "type": "number",
          "defaultValue": 0
        }
      }
    },
    {
      "opcode": "unregisterConditionalBroadcast",
      "blockType": "command",
      "text": "unregister [ID] conditional broadcast",
      "arguments": {
        "ID": {
          "type": "string",
          "defaultValue": "watcher"
        }
      }
    }
  ]
}
